{
  "name": "zerodha-kite-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only MCP server for Zerodha Kite Connect portfolio and quote data.",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "server": "node src/web-server.js",
    "client": "vite src/client --port 3003",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,cyan\" \"node -e \\\"process.env.PORT='3004'; import('./src/web-server.js')\\\"\" \"vite src/client\"",
    "build": "vite build src/client",
    "dashboard": "npm run build && node src/web-server.js",
    "smoke": "node scripts/smoke.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.1",
    "sass": "^1.83.4",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.11"
  }
}

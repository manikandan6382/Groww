{
  "name": "zerodha-kite-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only MCP server for Zerodha Kite Connect portfolio and quote data.",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "server": "dotnet run --project server-dotnet/TradingSystem.Api",
    "client": "vite src/client --port 3003",
    "dev": "concurrently --restart-tries -1 --restart-after 1000 -n \"DOTNET,NODE,FRONTEND\" -c \"magenta,green,cyan\" \"dotnet run --project server-dotnet/TradingSystem.Api\" \"node src/web-server.js\" \"vite src/client\"",
    "build:backend": "dotnet build server-dotnet",
    "test:backend": "dotnet test server-dotnet",
    "audit:scope": "node scripts/audit-bindings.mjs",
    "predev": "node scripts/audit-bindings.mjs",
    "prebuild": "node scripts/audit-bindings.mjs",
    "build": "vite build src/client",
    "dashboard": "npm run build && dotnet run --project server-dotnet/TradingSystem.Api",
    "smoke": "node scripts/smoke.js",
    "token:refresh": "node scripts/upstox-token-refresh.js",
    "backup": "node scripts/backup-database.js",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.475.0",
    "protobufjs": "^8.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "ws": "^8.22.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.1",
    "sass": "^1.83.4",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.11"
  }
}

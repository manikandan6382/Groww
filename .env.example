# Copy this file to .env and fill in values from https://developers.kite.trade/
# Never commit .env or share these values in chat.
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Optional. Usually you will generate this daily with the kite_generate_session tool.
# KITE_ACCESS_TOKEN=your_access_token_here

# Optional. Defaults to .zerodha-session.json in this folder.
# KITE_SESSION_FILE=.zerodha-session.json

# Optional. Enables the Foreign Investing Radar card with free research data.
# Keep this server-side only; the browser uses /api/alpha/foreign-quotes.
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Optional. Upstox live option LTP for Live Alerts.
# Redirect URL in Upstox app: http://127.0.0.1:3000/upstox/callback
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_REDIRECT_URI=http://127.0.0.1:3000/upstox/callback
# Optional. Defaults to data/upstox-session.json and is created by /upstox/callback.
# UPSTOX_SESSION_FILE=data/upstox-session.json
# Optional. Defaults to 3000 ms. Keep this respectful for free APIs.
# UPSTOX_LTP_POLL_MS=3000

# Safety defaults for this dashboard.
TRADING_MODE=read_only
FOREIGN_BROKER=none
